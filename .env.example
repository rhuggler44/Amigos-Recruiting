# Copy to .env and fill in. Never commit the real .env.

# Password for the dashboard login.
ADMIN_PASSWORD=change-me
# Long random string (32+ chars) used to sign sessions/unsubscribe links and encrypt inbox passwords.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it after inboxes are added, or saved passwords can't be decrypted.
APP_SECRET=

# Public HTTPS address of this app. Used for unsubscribe links and the logo in emails.
# Ideally a subdomain of your outreach domain, e.g. https://go.amigoshiring.com
PUBLIC_URL=http://localhost:3000
PORT=3000

# dry-run = write emails to data/outbox/*.eml instead of sending. Switch to live when ready.
SEND_MODE=dry-run

# Optional: lets Claude write fresh copy for each month's campaign.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional tuning
# HOST=127.0.0.1   (listen only on localhost when behind a reverse proxy)
# CRON_KEY=        (enables /cron/tick?key=... for hosts that put idle apps to sleep)
# DATA_DIR=data
# TICK_SECONDS=30
# IMAP_POLL_MINUTES=5
# SCHEDULER=off   (disable automatic sending, e.g. on a second instance)
